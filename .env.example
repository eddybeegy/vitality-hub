# ── Core ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public base URL of the deployment (used for OAuth redirects, etc.)
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# One of: sqlite, postgres, mariadb
DATABASE_TYPE=sqlite
# SQLITE_PATH=/app/data/health.db
# POSTGRES_URL="postgresql://user:password@host:5432/health"
# MARIADB_URL="mysql://user:password@host:3306/health"

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Sign JWTs. Generate with: openssl rand -base64 32
# The server refuses to start if this is unset.
JWT_SECRET=

# Bootstrap password for the primary administrator (user id 1) on first login.
# Set this, log in once as the admin email, then you may unset it.
ADMIN_PASSWORD=

# ── AI provider ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
HEVY_API_KEY=
CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
# Minimum level written to the log file and the `logs` table: debug, info, warn, error.
# Default info. debug is the per-row ingest trail (withings per measurement, hevy per
# routine, cronometer parse steps) and per-request API chatter -- most of the volume.
# LOG_LEVEL=info
# Record debug for just these sources while leaving LOG_LEVEL at info, e.g. to trace
# one integration's sync: LOG_DEBUG_SOURCES=withings,cronometer
# LOG_DEBUG_SOURCES=
