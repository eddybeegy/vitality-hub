# ── Core ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Public base URL of the deployment (used for OAuth redirects, etc.)
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# One of: sqlite, postgres, mariadb
DATABASE_TYPE=sqlite
# SQLITE_PATH=/app/data/health.db
# POSTGRES_URL="postgresql://user:password@host:5432/health"
# MARIADB_URL="mysql://user:password@host:3306/health"

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Sign JWTs. Generate with: openssl rand -base64 32
# The server refuses to start if this is unset, and `docker compose up` refuses to
# start the stack (there is deliberately no default). Changing it signs everyone out.
JWT_SECRET=

# Bootstrap password for the primary administrator (user id 1) on first login.
# Set this, log in once as the admin email, then you may unset it.
ADMIN_PASSWORD=

# ── AI provider ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Optional integrations ────────────────────────────────────────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
HEVY_API_KEY=
CRONOMETER_USERNAME=
CRONOMETER_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
# Minimum level written to the log file and the `logs` table: debug, info, warn, error.
# Default info. debug is the per-row ingest trail (withings per measurement, hevy per
# routine, cronometer parse steps) and per-request API chatter -- most of the volume.
# LOG_LEVEL=info
# Record debug for just these sources while leaving LOG_LEVEL at info, e.g. to trace
# one integration's sync: LOG_DEBUG_SOURCES=withings,cronometer
# LOG_DEBUG_SOURCES=

# ── Optional, less common ────────────────────────────────────────────────────
# Claude as a server-wide AI provider (users can also set their own key in Settings).
# ANTHROPIC_API_KEY=
# Behind a reverse proxy or tunnel: a hop count (e.g. 1) or a comma-separated address
# list. `true` is refused because it makes req.ip spoofable.
# TRUST_PROXY=
# Health Auto Export: also accept token-less pushes from local network addresses.
# HEALTH_EXPORT_ALLOW_LOCAL_FALLBACK=false
# Roll raw apple_health samples older than N days into daily rows. 0/unset = keep all.
# GRANULAR_RETENTION_DAYS=0
# Rows per batch for the streaming CSV/JSON exports.
# EXPORT_BATCH_ROWS=20000

# ── Coach agent (off-box AI insights and chat) ───────────────────────────────
# Scoped service token: lets the coach agent call an allowlist of endpoints as one user.
# COACH_SERVICE_TOKEN=
# COACH_SERVICE_USER_ID=
# HMAC secret shared with coach. Empty disables regenerate and chat forwarding.
# VITALITY_CHAT_SHARED_SECRET=
# COACH_REGEN_URL=http://172.20.0.1:3001/webhook/vitality-regen
# COACH_REGEN_ENABLED=1
# COACH_REGEN_TIMEOUT_MS=10000
# COACH_CHAT_URL=http://172.20.0.1:3001/webhook/vitality-chat
# COACH_CHAT_ENABLED=1
# COACH_CHAT_TIMEOUT_MS=60000
# Stale-insight watchdog.
# INSIGHT_STALE_HOURS=36
# INSIGHT_WATCHDOG_INTERVAL_MIN=60
# INSIGHT_TRIGGER_COOLDOWN_HOURS=6
